rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 256 && id.matches('^[a-zA-Z0-9_\\-\\.]+$'); }

    function isValidLocalStorageItem(data) {
      return data.keys().hasAll(['value']) 
          && data.keys().size() == 1
          && data.value is string 
          && data.value.size() <= 500000;
    }

    match /users/{userId} {
      match /localStorageSync/{keyId} {
        allow get: if isOwner(userId) && isValidId(keyId);
        allow list: if isOwner(userId);
        
        allow create: if isOwner(userId) 
          && isValidId(keyId)
          && isValidLocalStorageItem(incoming());
          
        allow update: if isOwner(userId) 
          && isValidId(keyId)
          && isValidLocalStorageItem(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['value']);
          
        allow delete: if isOwner(userId) && isValidId(keyId);
      }
    }
  }
}
